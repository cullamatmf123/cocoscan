{
  "expo": {
    "name": "CocoScan",
    "slug": "cocoscan",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/cocoscan-logo.png",
    "scheme": "cocoscan",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5A3D"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cocoscan-logo.png",
        "backgroundColor": "#2D5A3D"
      },
      "package": "com.cecil01.cocoscan",
      "versionCode": 1,
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "cecil01",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {},
    "extra": {
      "eas": {
        "projectId": "992d1934-0237-49e5-9f85-44134b79ddf1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/992d1934-0237-49e5-9f85-44134b79ddf1"
    }
  }
}
